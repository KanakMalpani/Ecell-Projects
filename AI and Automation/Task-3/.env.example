# LLM provider: ollama (default) | gemini | mock
LLM_PROVIDER=ollama

# Ollama (Option A - local, recommended)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b-instruct

# Google Gemini (Option B - API, optional)
GEMINI_API_KEY=

# API security (change JWT_SECRET in production)
JWT_SECRET=ecell-crm-dev-secret-change-in-production
API_HOST=127.0.0.1
API_PORT=8002
