# LLM provider: ollama (default) | gemini | mock
LLM_PROVIDER=ollama

# Ollama (Option A - local, recommended)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b-instruct

# Google Gemini (Option B - API, optional)
GEMINI_API_KEY=

# Security — REQUIRED before any public deployment
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://127.0.0.1:8002,http://localhost:8002
CRM_ENV=development
MAX_LIST_LIMIT=500

# Demo users (username:password:role:agent_id;...) — override for evaluation
# CRM_DEMO_USERS=agent1:agent123:agent:AGT-001;analytics1:analytics123:analytics:ANL-001

# API
API_HOST=127.0.0.1
API_PORT=8002
